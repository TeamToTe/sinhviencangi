# ==========================================
# HOLA MAP - Frontend Environment Configuration
# ==========================================

# Set to 'false' to connect to real backend API endpoints
VITE_USE_MOCK=true

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# CARTO Basemaps API Key (Optional)
# Get free key from: https://carto.com/ or https://app.carto.com/
# Leave empty to use default high-performance Open World Street tiles
VITE_CARTO_API_KEY=
