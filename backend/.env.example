# Server Port & Host
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# CORS Allow Origin
CORS_ORIGIN=*

# Database Configuration:
# 1. Để trống DATABASE_URL nếu muốn chạy SQLite Embedded tự động (zero configuration).
# 2. Điền chuỗi kết nối PostgreSQL / Supabase nếu muốn chạy production:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?sslmode=require
DATABASE_URL=

# SQLite Database File Path (dành cho chế độ Local)
SQLITE_PATH=./data/connecthub.sqlite
